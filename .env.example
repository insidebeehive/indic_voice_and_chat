# --- Provider API keys ---
# Declared in Secrets (src/config.py) for auditability only — adapters still
# resolve these via os.environ.get(...) directly; declaring does not wire
# them up to any adapter.
# ANTHROPIC_API_KEY=          # Claude LLM provider
# AZURE_SPEECH_KEY=           # Azure Speech STT/TTS key
# AZURE_SPEECH_REGION=        # Azure Speech service region
# GOOGLE_TTS_API_KEY=         # Google Cloud TTS API key
# VLLM_BASE_URL=              # Self-hosted vLLM OpenAI-compatible endpoint (IndicF5 pod)
# VLLM_API_KEY=               # Self-hosted vLLM API key
# INDICF5_TTS_URL=            # Self-hosted IndicF5 fine-tuned TTS endpoint
# EXOTEL_ACCOUNT_SID is already declared below under Telephony.

# STT
SARVAM_API_KEY=
GROQ_API_KEY=

# LLM (GROQ_API_KEY shared above)
GEMINI_API_KEY=
# Explicit Gemini context caching (docs/llm-prompt-caching.md). Unset = OFF.
# Accepts 1/true/yes/on, read live on every call so flipping it needs no
# restart. Caches the static system prompt + tool declarations per tenant —
# tool declarations alone measured 4,894 tokens, and Gemini's implicit cache
# never covers them. Read the result off the cache-hit figure in the
# backoffice Analytics tab.
GEMINI_EXPLICIT_CACHE=
# TTL in seconds for a created cache; default 1800. Explicit caches bill
# storage per token-hour, so this bounds idle waste after a tenant goes quiet.
GEMINI_CACHE_TTL_S=

# TTS (SARVAM_API_KEY shared above)
DEEPGRAM_API_KEY=

# Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
# Stringee — REST API Key SID + Secret (Stringee dashboard → Project →
# API Key). Used to mint short-lived JWT X-STRINGEE-AUTH tokens.
STRINGEE_API_KEY_SID=
STRINGEE_API_KEY_SECRET=

# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://vox:vox@localhost:5432/vox_agent
REDIS_URL=redis://localhost:6379/0

# --- Server ---
WEBHOOK_BASE_URL=https://your-domain.example.com

# --- Chat ---
# Seconds of customer silence before an AI chat auto-closes and sends
# session_closed to the CRM. Unset = 300; 0 disables the auto-close. A tenant's
# own chat_support.chat_idle_timeout_seconds overrides this. Read when a
# tenant's config is loaded, so a change needs a restart.
CHAT_IDLE_TIMEOUT_SECONDS=
# Retries of failed session_closed webhooks to the CRM (webhook_outbox table,
# up to ~24h). Unset = on; 0/false/no/off pauses the retries without a restart
# (the first, in-line attempt still happens).
WEBHOOK_OUTBOX_ENABLED=
# HMAC-SHA256 key for outbound webhooks to the CRM (session_started,
# escalation_requested, session_closed, chat.escalated): sent as
# X-Signature: sha256=<hex of the raw body>. A tenant's own key, set in the
# backoffice (CRM tab → Events webhook → Signing secret), takes priority; this
# is only the fallback for tenants without one. Unset = those go out unsigned (and a
# warning is logged on each). Share the same value with the CRM so it can
# verify. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
EVENTS_WEBHOOK_SECRET=

# --- Config file location (optional override) ---
VOX_CONFIG_PATH=config/default.yaml
